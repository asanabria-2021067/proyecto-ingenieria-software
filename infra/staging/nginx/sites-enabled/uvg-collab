server {
    listen 80;
    listen 443 ssl;
    ssl_certificate /etc/nginx/harness-tls/fullchain.pem;
    ssl_certificate_key /etc/nginx/harness-tls/privkey.pem;

    # [G02-C16] Exclusion declarada (ver infra/nginx/manifest.json): en produccion
    # [G02-C16] este server tambien sirve estaticos de otros proyectos del host,
    # [G02-C16] ajenos a UVG Collab. No se versionan ni se modifican desde aqui.
    # @g02-excluded-locations /angel/ /derek/ /vernel/

    location /.well-known/acme-challenge/ {
        root /var/www/html;
    }

    # Frontend UVG Collab
    location / {
        proxy_pass http://frontend:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
    }

    # Backend API
    location /api {
        if ($http_accept ~* "text/html") {
            return 403;
        }

        proxy_pass http://backend:3001;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
    }
}
