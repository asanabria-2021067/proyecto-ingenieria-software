# [G06-H4] Puerto 80 en server propio: solo el desafio ACME y la redireccion a HTTPS.
# El return va DENTRO de location / para no redirigir /.well-known/acme-challenge/.
server {
    listen 80;
    server_tokens off;

    location /.well-known/acme-challenge/ {
        root /var/www/html;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# [G06-H7] HSTS sin includeSubDomains ni preload (el dominio es un nip.io compartido).
# Los location ajenos (/angel/ /derek/ /vernel/) del host real quedan en este server;
# si alguno define su propio add_header, anula la herencia del HSTS (verificar en la VM).
server {
    listen 443 ssl;
    server_tokens off;
    add_header Strict-Transport-Security "max-age=31536000" always;
    ssl_certificate /etc/nginx/harness-tls/fullchain.pem;
    ssl_certificate_key /etc/nginx/harness-tls/privkey.pem;

    # [G02-C16] Exclusion declarada (ver infra/nginx/manifest.json): en produccion
    # [G02-C16] este server tambien sirve estaticos de otros proyectos del host,
    # [G02-C16] ajenos a UVG Collab. No se versionan ni se modifican desde aqui.
    # @g02-excluded-locations /angel/ /derek/ /vernel/

    location /.well-known/acme-challenge/ {
        root /var/www/html;
    }

    # Frontend UVG Collab
    location / {
        proxy_pass http://frontend:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
    }

    # [G04-C11] P1: Socket.IO (chat y notificaciones) por el mismo origen.
    # Polling HTTP y upgrade a WebSocket hacia el backend; el timeout cubre el
    # ciclo de ping de Socket.IO (25s + 20s) con margen.
    location /socket.io/ {
        proxy_pass http://backend:3001;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
    }

    # Backend API
    location /api {
        if ($http_accept ~* "text/html") {
            return 403;
        }

        # Helmet ya manda su HSTS; se oculta para dejar solo el del borde.
        proxy_hide_header Strict-Transport-Security;

        proxy_pass http://backend:3001;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
    }
}
