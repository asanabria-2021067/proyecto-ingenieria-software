# T-313 · configuración de pg-backup.sh. Copiar FUERA del repositorio, por
# ejemplo a /etc/uvgenius/backup.env, con permisos 600 y dueño el usuario que
# ejecuta el cron. El script rechaza este archivo si otros pueden leerlo.
#
# Aquí no va ningún valor real: los de abajo son marcadores.

# Directorio del HOST donde quedan los respaldos (ruta absoluta, fuera del
# contenedor y de cualquier repositorio Git). Se crea con permisos 700.
BACKUP_DIR=/var/backups/uvgenius/postgres

# Prefijo de los archivos: <prefijo>_<base>_<AAAAMMDDTHHMMSSZ>.dump
BACKUP_PREFIX=uvgenius

# Espacio libre mínimo, en MB, para empezar un respaldo.
BACKUP_MIN_FREE_MB=500

# Contenedor de PostgreSQL. Con este valor, pg_dump corre dentro del contenedor
# (misma versión que el servidor) y el archivo se escribe en el host.
# Vacío = usar el pg_dump del host contra PGHOST/PGPORT.
PG_CONTAINER=uvg-collab-db

PGDATABASE=CAMBIAR_nombre_de_la_base
PGUSER=CAMBIAR_usuario

# Solo sin PG_CONTAINER:
# PGHOST=127.0.0.1
# PGPORT=5432

# La contraseña: una de las dos. Nunca en la línea de comandos ni en el crontab.
PGPASSWORD=CAMBIAR_contraseña
# PGPASSFILE=/etc/uvgenius/pgpass
