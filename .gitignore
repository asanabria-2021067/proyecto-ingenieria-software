# ── Configuracion local de Claude Code (nunca se versiona) ──
.claude/

# ── Dependencias ──────────────────────────────────────────
node_modules/
.pnpm-store/

# ── Build outputs ─────────────────────────────────────────
dist/
.next/
out/
build/

# ── Env (solo se commitea el .example) ────────────────────
.env
.env.local
.env.*.local
# G01 (FASE2-N08): cualquier variante de .env con valores reales.
.env.*
!.env.example

# ── Docker ────────────────────────────────────────────────
docker-compose.override.yml

# ── IDE / Editor ──────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ── OS ────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Logs ──────────────────────────────────────────────────
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Testing ───────────────────────────────────────────────
coverage/
.nyc_output/
playwright-report/
# T-318: reporte del paso de accesibilidad (axe) de la suite E2E.
playwright-report-a11y/
test-results/
blob-report/
k6/results/*
!k6/results/.gitkeep

# ── TypeScript ────────────────────────────────────────────
*.tsbuildinfo

# ── Misc ──────────────────────────────────────────────────
*.pid
*.seed
*.pid.lock

pnpm-lock.yaml
apps/frontend/e2e/support/.auth-cache/

# ── G01 (FASE2-N08): dumps, backups y material de clave ───
# Nunca dentro del árbol del repositorio: los backups de BD contienen PII y
# viven cifrados fuera de él. Las migraciones .sql de Prisma NO se ignoran.
*.dump
*.dump.*
*.pgdump
*.backup
*.sql.gz
backups/
backup/
owasp-wip/
*.pem
*.key
*.p12
*.pfx

# ── IESUC-568 (RTF 3.7): salida de tsc de las configs de Vitest ──
# vitest.config.ts es la única fuente; un .js emitido al lado quedaría obsoleto.
apps/backend/vitest*.config.js
apps/backend/vitest*.config.js.map
apps/backend/vitest*.config.d.ts
