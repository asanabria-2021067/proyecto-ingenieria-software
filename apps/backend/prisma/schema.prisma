generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum EstadoUsuario {
  ACTIVO
  INACTIVO
  BLOQUEADO
}

enum TipoTelefono {
  PERSONAL
  TRABAJO
  EMERGENCIA
  OTRO
}

enum EstadoCarrera {
  ACTIVA
  INACTIVA
}

enum NivelHabilidad {
  BASICO
  INTERMEDIO
  AVANZADO
}

enum TipoExperiencia {
  PROYECTO_UNIVERSITARIO
  PASANTIA
  VOLUNTARIADO
  INVESTIGACION
  OTRO
}

enum TipoOrganizacion {
  ASOCIACION
  INSTITUTO
  GRUPO_ESTUDIANTIL
  CENTRO_INVESTIGACION
  OTRO
}

enum EstadoOrganizacion {
  ACTIVA
  INACTIVA
}

enum RolOrganizacion {
  PROPIETARIO
  ADMINISTRADOR
  MIEMBRO
}

enum EstadoMembresia {
  ACTIVA
  INACTIVA
}

enum TipoProyecto {
  ACADEMICO_HORAS_BECA
  ACADEMICO_EXPERIENCIA
  EXTRACURRICULAR_EXTENSION
}

enum EstadoProyecto {
  BORRADOR
  EN_REVISION
  OBSERVADO
  PUBLICADO
  EN_PROGRESO
  EN_SOLICITUD_CIERRE
  CERRADO
  CANCELADO
}

enum EstadoRevisionProyecto {
  PENDIENTE
  APROBADA
  OBSERVADA
}

enum ModalidadProyecto {
  PRESENCIAL
  VIRTUAL
  MIXTA
}

enum RolOrganizacionProyecto {
  PRINCIPAL
  COLABORADORA
}

enum EstadoPostulacion {
  PENDIENTE
  ACEPTADA
  RECHAZADA
}

enum EstadoParticipacion {
  ACTIVO
  RETIRADO
  COMPLETADO
}

enum EstadoHito {
  PENDIENTE
  EN_PROGRESO
  COMPLETADO
}

enum EstadoTarea {
  POR_HACER
  EN_PROGRESO
  EN_REVISION
  HECHO
}

enum Prioridad {
  BAJA
  MEDIA
  ALTA
}

enum TipoEvidencia {
  ENLACE
  ARCHIVO
  REPORTE
}

enum ResultadoRevision {
  APROBADA
  RECHAZADA
}

enum EstadoHoras {
  PENDIENTE
  APROBADA
  RECHAZADA
}

enum TipoCertificado {
  HORAS_BECA
  EXTENSION
  EXPERIENCIA
}

enum TipoNotificacion {
  NUEVA_POSTULACION
  POSTULACION_RESUELTA
  TAREA_ASIGNADA
  EVIDENCIA_REVISADA
  PROYECTO_PUBLICADO
  HORAS_VALIDADAS
  CERTIFICADO_EMITIDO
  PARTICIPACION_ACTUALIZADA
  PROYECTO_EN_REVISION
  PROYECTO_OBSERVADO
  PROYECTO_APROBADO
  PROYECTO_ACTUALIZADO
  CAMBIO_ESTADO_PROYECTO
  SOLICITUD_CIERRE_PROYECTO
  CIERRE_APROBADO
  CIERRE_RECHAZADO
  TAREA_ACTUALIZADA
  HITO_ACTUALIZADO
  COMENTARIO_PROYECTO
  COMENTARIO_TAREA
  COMENTARIO_HITO
  MENSAJE_REVISION
  PROYECTO_ADVERTENCIA_INACTIVIDAD
  ROL_ABANDONADO
  ROL_ASIGNADO_LIDER
  ROL_ACTUALIZADO
  SOLICITUD_RECUPERACION_CONTRASENA
  SOLICITUD_AMISTAD
  AMISTAD_ACEPTADA
  NUEVO_SEGUIDOR
}

enum EstadoAmistad {
  PENDIENTE
  ACEPTADA
  RECHAZADA
}

enum EstadoSolicitudRecuperacion {
  PENDIENTE
  ATENDIDA
}

enum EstadoSolicitudSalida {
  PREPARACION
  PENDIENTE_LIDER
  APROBADA
  RECHAZADA
  CANCELADA
}

enum EstadoSprint {
  ACTIVO
  EN_FINALIZACION
  CERRADO
}

enum TipoConversacion {
  GRUPAL
  INDIVIDUAL
}

model Usuario {
  idUsuario         Int           @id @default(autoincrement()) @map("id_usuario")
  correo            String        @unique @db.VarChar(255)
  contrasena        String        @db.VarChar(255)
  nombre            String        @db.VarChar(255)
  apellido          String        @db.VarChar(255)
  fotoUrl           String?       @map("foto_url") @db.VarChar(255)
  estado            EstadoUsuario @default(ACTIVO)
  fechaCreacion     DateTime      @default(now()) @map("fecha_creacion")
  fechaUltimaSesion DateTime?     @map("fecha_ultima_sesion")

  telefonos                        UsuarioTelefono[]
  perfil                           PerfilEstudiante?
  habilidades                      UsuarioHabilidad[]
  intereses                        UsuarioInteres[]
  cualidades                       UsuarioCualidad[]
  experiencias                     ExperienciaPrevia[]
  organizacionesCreadas            Organizacion[]
  membresiasOrganizacion           UsuarioOrganizacion[]
  proyectosCreados                 Proyecto[]
  postulaciones                    Postulacion[]              @relation("Postulante")
  postulacionesResueltas           Postulacion[]              @relation("PostulacionResolutor")
  participaciones                  ParticipacionProyecto[]
  tareasCreadas                    Tarea[]
  tareasAsignadas                  AsignacionTarea[]          @relation("TareaAsignada")
  tareasQueAsigno                  AsignacionTarea[]          @relation("TareaAsignador")
  evidenciasCargadas               Evidencia[]
  revisionesRealizadas             RevisionEvidencia[]
  horasAprobadas                   HorasParticipacion[]
  certificadosEmitidos             Certificado[]
  notificaciones                   Notificacion[]
  solicitudesRecuperacion          SolicitudRecuperacion[]    @relation("SolicitudRecuperacionUsuario")
  solicitudesRecuperacionAtendidas SolicitudRecuperacion[]    @relation("SolicitudRecuperacionAdmin")
  rolesAcceso                      UsuarioRolAcceso[]
  auditorias                       BitacoraAuditoria[]
  configuracionesActualizadas      ConfiguracionSistema[]
  revisionesProyectoRealizadas     RevisionProyecto[]         @relation("RevisionesProyectoRealizadas")
  comentariosEscritos              Comentario[]
  mensajesRevisionEnviados         MensajeRevisionProyecto[]  @relation("MensajesEnviados")
  solicitudesSalidaSolicitadas     SolicitudSalidaProyecto[]  @relation("SolicitudSalidaSolicitante")
  solicitudesSalidaResueltas       SolicitudSalidaProyecto[]  @relation("SolicitudSalidaResolutor")
  sprintsCerrados                  Sprint[]
  registrosAvanceEscritos          RegistroAvanceAsignacion[]
  amistadesSolicitadas             Amistad[]                  @relation("AmistadesSolicitadas")
  amistadesRecibidas               Amistad[]                  @relation("AmistadesRecibidas")
  siguiendo                        Seguimiento[]              @relation("Siguiendo")
  seguidores                       Seguimiento[]              @relation("Seguidores")
  conversacionesCreadas            Conversacion[]              @relation("ConversacionesCreadas")
  conversacionesParticipa          ConversacionParticipante[]
  mensajesChatEnviados             MensajeChat[]               @relation("MensajesChatEnviados")

  @@map("usuario")
}

model Amistad {
  idAmistad            Int           @id @default(autoincrement()) @map("id_amistad")
  idUsuarioSolicitante Int           @map("id_usuario_solicitante")
  idUsuarioReceptor    Int           @map("id_usuario_receptor")
  estado               EstadoAmistad @default(PENDIENTE)
  fechaSolicitud       DateTime      @default(now()) @map("fecha_solicitud")
  fechaResolucion      DateTime?     @map("fecha_resolucion")

  solicitante Usuario @relation("AmistadesSolicitadas", fields: [idUsuarioSolicitante], references: [idUsuario])
  receptor    Usuario @relation("AmistadesRecibidas", fields: [idUsuarioReceptor], references: [idUsuario])

  @@unique([idUsuarioSolicitante, idUsuarioReceptor])
  @@map("amistad")
}

model Seguimiento {
  idSeguimiento Int      @id @default(autoincrement()) @map("id_seguimiento")
  idSeguidor    Int      @map("id_seguidor")
  idSeguido     Int      @map("id_seguido")
  fechaCreacion DateTime @default(now()) @map("fecha_creacion")

  seguidor Usuario @relation("Siguiendo", fields: [idSeguidor], references: [idUsuario])
  seguido  Usuario @relation("Seguidores", fields: [idSeguido], references: [idUsuario])

  @@unique([idSeguidor, idSeguido])
  @@map("seguimiento")
}

model UsuarioTelefono {
  idUsuarioTelefono Int          @id @default(autoincrement()) @map("id_usuario_telefono")
  idUsuario         Int          @map("id_usuario")
  numero            String       @db.VarChar(30)
  tipoTelefono      TipoTelefono @default(PERSONAL) @map("tipo_telefono")
  esPrincipal       Boolean      @default(false) @map("es_principal")

  usuario Usuario @relation(fields: [idUsuario], references: [idUsuario])

  @@map("usuario_telefono")
}

model PerfilEstudiante {
  idUsuario                  Int       @id @map("id_usuario")
  carne                      String    @unique @db.VarChar(255)
  idCarrera                  Int?      @map("id_carrera")
  semestre                   Int?
  biografia                  String?   @db.Text
  enlacePortafolio           String?   @map("enlace_portafolio") @db.VarChar(255)
  githubUrl                  String?   @map("github_url") @db.VarChar(255)
  linkedinUrl                String?   @map("linkedin_url") @db.VarChar(255)
  disponibilidadHorasSemana  Int?      @map("disponibilidad_horas_semana")
  horasBecaRequeridas        Int?      @map("horas_beca_requeridas")
  horasExtensionRequeridas   Int?      @map("horas_extension_requeridas")
  urlCv                      String?   @map("url_cv") @db.VarChar(255)
  preferenciasNotificaciones Json?     @map("preferencias_notificaciones")
  fechaActualizacion         DateTime? @map("fecha_actualizacion")

  usuario Usuario  @relation(fields: [idUsuario], references: [idUsuario])
  carrera Carrera? @relation(fields: [idCarrera], references: [idCarrera])

  @@map("perfil_estudiante")
}

model Carrera {
  idCarrera          Int           @id @default(autoincrement()) @map("id_carrera")
  nombreCarrera      String        @map("nombre_carrera") @db.VarChar(255)
  facultad           String?       @db.VarChar(255)
  descripcionCarrera String?       @map("descripcion_carrera") @db.Text
  estado             EstadoCarrera @default(ACTIVA)

  perfiles      PerfilEstudiante[]
  rolesProyecto RolProyecto[]

  @@map("carrera")
}

model Habilidad {
  idHabilidad          Int     @id @default(autoincrement()) @map("id_habilidad")
  nombreHabilidad      String  @map("nombre_habilidad") @db.VarChar(255)
  categoriaHabilidad   String? @map("categoria_habilidad") @db.VarChar(255)
  descripcionHabilidad String? @map("descripcion_habilidad") @db.Text

  usuarioHabilidades UsuarioHabilidad[]
  experiencias       ExperienciaPrevia[]
  requisitosRol      RequisitoHabilidadRol[]

  @@map("habilidad")
}

model UsuarioHabilidad {
  idUsuarioHabilidad Int            @id @default(autoincrement()) @map("id_usuario_habilidad")
  idUsuario          Int            @map("id_usuario")
  idHabilidad        Int            @map("id_habilidad")
  nivelHabilidad     NivelHabilidad @default(BASICO) @map("nivel_habilidad")
  aniosExperiencia   Int?           @map("anios_experiencia")

  usuario   Usuario   @relation(fields: [idUsuario], references: [idUsuario])
  habilidad Habilidad @relation(fields: [idHabilidad], references: [idHabilidad])

  @@unique([idUsuario, idHabilidad])
  @@map("usuario_habilidad")
}

model Interes {
  idInteres          Int     @id @default(autoincrement()) @map("id_interes")
  nombreInteres      String  @unique @map("nombre_interes") @db.VarChar(255)
  descripcionInteres String? @map("descripcion_interes") @db.Text

  usuarioIntereses  UsuarioInteres[]
  proyectoIntereses ProyectoInteres[]

  @@map("interes")
}

model UsuarioInteres {
  idUsuarioInteres Int @id @default(autoincrement()) @map("id_usuario_interes")
  idUsuario        Int @map("id_usuario")
  idInteres        Int @map("id_interes")

  usuario Usuario @relation(fields: [idUsuario], references: [idUsuario])
  interes Interes @relation(fields: [idInteres], references: [idInteres])

  @@unique([idUsuario, idInteres])
  @@map("usuario_interes")
}

model Cualidad {
  idCualidad          Int     @id @default(autoincrement()) @map("id_cualidad")
  nombreCualidad      String  @unique @map("nombre_cualidad") @db.VarChar(100)
  descripcionCualidad String? @map("descripcion_cualidad") @db.Text

  usuarioCualidades UsuarioCualidad[]

  @@map("cualidad")
}

model UsuarioCualidad {
  idUsuarioCualidad Int @id @default(autoincrement()) @map("id_usuario_cualidad")
  idUsuario         Int @map("id_usuario")
  idCualidad        Int @map("id_cualidad")

  usuario  Usuario  @relation(fields: [idUsuario], references: [idUsuario])
  cualidad Cualidad @relation(fields: [idCualidad], references: [idCualidad])

  @@unique([idUsuario, idCualidad])
  @@map("usuario_cualidad")
}

model ExperienciaPrevia {
  idExperiencia             Int             @id @default(autoincrement()) @map("id_experiencia")
  idUsuario                 Int             @map("id_usuario")
  tituloProyectoExperiencia String          @map("titulo_proyecto_experiencia") @db.VarChar(255)
  rolDesempenado            String?         @map("rol_desempenado") @db.VarChar(255)
  idHabilidadPrincipal      Int?            @map("id_habilidad_principal")
  verificable               Boolean         @default(false)
  fechaInicio               DateTime?       @map("fecha_inicio") @db.Date
  fechaFin                  DateTime?       @map("fecha_fin") @db.Date
  tipoExperiencia           TipoExperiencia @default(OTRO) @map("tipo_experiencia")

  usuario            Usuario    @relation(fields: [idUsuario], references: [idUsuario])
  habilidadPrincipal Habilidad? @relation(fields: [idHabilidadPrincipal], references: [idHabilidad])

  @@map("experiencia_previa")
}

model Organizacion {
  idOrganizacion          Int                @id @default(autoincrement()) @map("id_organizacion")
  nombreOrganizacion      String             @map("nombre_organizacion") @db.VarChar(255)
  tipoOrganizacion        TipoOrganizacion   @default(OTRO) @map("tipo_organizacion")
  descripcionOrganizacion String?            @map("descripcion_organizacion") @db.Text
  correoContacto          String?            @map("correo_contacto") @db.VarChar(255)
  telefonoContacto        String?            @map("telefono_contacto") @db.VarChar(255)
  sitioWeb                String?            @map("sitio_web") @db.VarChar(255)
  logoUrl                 String?            @map("logo_url") @db.VarChar(255)
  estadoOrganizacion      EstadoOrganizacion @default(ACTIVA) @map("estado_organizacion")
  creadaPor               Int                @map("creada_por")
  fechaCreacion           DateTime           @default(now()) @map("fecha_creacion")

  creador   Usuario                @relation(fields: [creadaPor], references: [idUsuario])
  miembros  UsuarioOrganizacion[]
  proyectos ProyectoOrganizacion[]

  @@map("organizacion")
}

model UsuarioOrganizacion {
  idUsuarioOrganizacion Int             @id @default(autoincrement()) @map("id_usuario_organizacion")
  idUsuario             Int             @map("id_usuario")
  idOrganizacion        Int             @map("id_organizacion")
  rolOrganizacion       RolOrganizacion @default(MIEMBRO) @map("rol_organizacion")
  fechaIngreso          DateTime        @default(now()) @map("fecha_ingreso")
  estadoMembresia       EstadoMembresia @default(ACTIVA) @map("estado_membresia")

  usuario      Usuario      @relation(fields: [idUsuario], references: [idUsuario])
  organizacion Organizacion @relation(fields: [idOrganizacion], references: [idOrganizacion])

  @@unique([idUsuario, idOrganizacion])
  @@map("usuario_organizacion")
}

model Proyecto {
  idProyecto          Int               @id @default(autoincrement()) @map("id_proyecto")
  tituloProyecto      String            @map("titulo_proyecto") @db.VarChar(200)
  descripcionProyecto String            @map("descripcion_proyecto") @db.Text
  objetivosProyecto   String?           @map("objetivos_proyecto") @db.Text
  tipoProyecto        TipoProyecto      @map("tipo_proyecto")
  estadoProyecto      EstadoProyecto    @default(BORRADOR) @map("estado_proyecto")
  modalidadProyecto   ModalidadProyecto @default(MIXTA) @map("modalidad_proyecto")
  ubicacionProyecto   String?           @map("ubicacion_proyecto") @db.VarChar(255)
  contextoAcademico   String?           @map("contexto_academico") @db.VarChar(255)
  urlRecursoExterno   String?           @map("url_recurso_externo") @db.VarChar(255)
  fechaPublicacion    DateTime?         @map("fecha_publicacion") @db.Date
  fechaInicio         DateTime?         @map("fecha_inicio") @db.Date
  fechaFinEstimada    DateTime?         @map("fecha_fin_estimada") @db.Date
  /// Fuente de verdad del líder del proyecto. No existe una `ParticipacionProyecto` equivalente para el líder: no asumirla ni inventarla.
  creadoPor           Int               @map("creado_por")
  fechaCreacion       DateTime          @default(now()) @map("fecha_creacion")
  fechaActualizacion  DateTime?         @map("fecha_actualizacion")
  eliminadoEn         DateTime?         @map("eliminado_en")

  creador           Usuario                   @relation(fields: [creadoPor], references: [idUsuario])
  organizaciones    ProyectoOrganizacion[]
  intereses         ProyectoInteres[]
  roles             RolProyecto[]
  hitos             Hito[]
  tareas            Tarea[]
  revisiones        RevisionProyecto[]
  comentarios       Comentario[]
  mensajesRevision  MensajeRevisionProyecto[]
  etiquetas         Etiqueta[]
  solicitudesSalida SolicitudSalidaProyecto[]
  sprints           Sprint[]
  conversaciones    Conversacion[]

  @@map("proyecto")
}

model RevisionProyecto {
  idRevisionProyecto Int                    @id @default(autoincrement()) @map("id_revision_proyecto")
  idProyecto         Int                    @map("id_proyecto")
  idRevisor          Int?                   @map("id_revisor")
  estadoRevision     EstadoRevisionProyecto @default(PENDIENTE) @map("estado_revision")
  comentarioRevision String?                @map("comentario_revision") @db.Text
  snapshotProyecto   Json?                  @map("snapshot_proyecto")
  numeroEnvio        Int                    @map("numero_envio")
  enviadaEn          DateTime               @default(now()) @map("enviada_en")
  revisadaEn         DateTime?              @map("revisada_en")

  proyecto Proyecto                  @relation(fields: [idProyecto], references: [idProyecto])
  revisor  Usuario?                  @relation("RevisionesProyectoRealizadas", fields: [idRevisor], references: [idUsuario])
  mensajes MensajeRevisionProyecto[]

  @@map("revision_proyecto")
}

model ProyectoOrganizacion {
  idProyectoOrganizacion Int                     @id @default(autoincrement()) @map("id_proyecto_organizacion")
  idProyecto             Int                     @map("id_proyecto")
  idOrganizacion         Int                     @map("id_organizacion")
  rolOrganizacion        RolOrganizacionProyecto @default(PRINCIPAL) @map("rol_organizacion")
  fechaVinculacion       DateTime                @default(now()) @map("fecha_vinculacion")

  proyecto     Proyecto     @relation(fields: [idProyecto], references: [idProyecto])
  organizacion Organizacion @relation(fields: [idOrganizacion], references: [idOrganizacion])

  @@unique([idProyecto, idOrganizacion])
  @@map("proyecto_organizacion")
}

model ProyectoInteres {
  idProyectoInteres Int @id @default(autoincrement()) @map("id_proyecto_interes")
  idProyecto        Int @map("id_proyecto")
  idInteres         Int @map("id_interes")

  proyecto Proyecto @relation(fields: [idProyecto], references: [idProyecto])
  interes  Interes  @relation(fields: [idInteres], references: [idInteres])

  @@unique([idProyecto, idInteres])
  @@map("proyecto_interes")
}

model RolProyecto {
  idRolProyecto           Int     @id @default(autoincrement()) @map("id_rol_proyecto")
  idProyecto              Int     @map("id_proyecto")
  nombreRol               String  @map("nombre_rol") @db.VarChar(255)
  descripcionRolProyecto  String? @map("descripcion_rol_proyecto") @db.Text
  idCarreraRequerida      Int?    @map("id_carrera_requerida")
  cupos                   Int     @default(1)
  horasSemanalesEstimadas Int?    @map("horas_semanales_estimadas")

  proyecto         Proyecto                @relation(fields: [idProyecto], references: [idProyecto])
  carreraRequerida Carrera?                @relation(fields: [idCarreraRequerida], references: [idCarrera])
  requisitos       RequisitoHabilidadRol[]
  postulaciones    Postulacion[]
  participaciones  ParticipacionProyecto[]
  tareas           Tarea[]

  @@map("rol_proyecto")
}

model RequisitoHabilidadRol {
  idRequisitoHabilidad Int            @id @default(autoincrement()) @map("id_requisito_habilidad")
  idRolProyecto        Int            @map("id_rol_proyecto")
  idHabilidad          Int            @map("id_habilidad")
  nivelMinimo          NivelHabilidad @default(BASICO) @map("nivel_minimo")
  obligatorio          Boolean        @default(true)

  rolProyecto RolProyecto @relation(fields: [idRolProyecto], references: [idRolProyecto])
  habilidad   Habilidad   @relation(fields: [idHabilidad], references: [idHabilidad])

  @@unique([idRolProyecto, idHabilidad])
  @@map("requisito_habilidad_rol")
}

/// Representa la solicitud/postulación para ocupar un rol del proyecto. Sprint 6 (T-117/T-118) debe reutilizar este concepto: no crear un `SolicitudRol` paralelo.
model Postulacion {
  idPostulacion        Int               @id @default(autoincrement()) @map("id_postulacion")
  idUsuarioPostulante  Int               @map("id_usuario_postulante")
  idRolProyecto        Int               @map("id_rol_proyecto")
  justificacion        String            @db.Text
  estadoPostulacion    EstadoPostulacion @default(PENDIENTE) @map("estado_postulacion")
  fechaPostulacion     DateTime          @default(now()) @map("fecha_postulacion")
  fechaResolucion      DateTime?         @map("fecha_resolucion")
  resueltaPor          Int?              @map("resuelta_por")
  comentarioResolucion String?           @map("comentario_resolucion") @db.Text

  postulante      Usuario                 @relation("Postulante", fields: [idUsuarioPostulante], references: [idUsuario])
  resolutor       Usuario?                @relation("PostulacionResolutor", fields: [resueltaPor], references: [idUsuario])
  rolProyecto     RolProyecto             @relation(fields: [idRolProyecto], references: [idRolProyecto])
  participaciones ParticipacionProyecto[]

  @@index([idUsuarioPostulante, idRolProyecto])
  @@index([estadoPostulacion])
  @@index([idRolProyecto, estadoPostulacion])
  @@map("postulacion")
}

/// Invariante enforced por PostgreSQL (no por Prisma): a lo sumo una participación ACTIVO por (idUsuario, idRolProyecto), vía índice único parcial `participacion_proyecto_activa_unique` (migración `20260726000100_enforce_one_active_participation`).
/// Representa la participación de un usuario en UN rol del proyecto; no representa por sí sola la identidad person-centric del integrante (un usuario puede tener varias filas, una por rol).
model ParticipacionProyecto {
  idParticipacion     Int                 @id @default(autoincrement()) @map("id_participacion")
  idUsuario           Int                 @map("id_usuario")
  idRolProyecto       Int                 @map("id_rol_proyecto")
  idPostulacion       Int?                @map("id_postulacion")
  estadoParticipacion EstadoParticipacion @default(ACTIVO) @map("estado_participacion")
  fechaIngreso        DateTime            @default(now()) @map("fecha_ingreso") @db.Date
  fechaSalida         DateTime?           @map("fecha_salida") @db.Date

  usuario           Usuario              @relation(fields: [idUsuario], references: [idUsuario])
  rolProyecto       RolProyecto          @relation(fields: [idRolProyecto], references: [idRolProyecto])
  postulacion       Postulacion?         @relation(fields: [idPostulacion], references: [idPostulacion])
  registrosHoras    HorasParticipacion[]
  certificados      Certificado[]
  asignacionesTarea AsignacionTarea[]

  @@index([idRolProyecto, estadoParticipacion])
  @@index([idUsuario, estadoParticipacion])
  @@map("participacion_proyecto")
}

/// Identidad de la solicitud = (idProyecto, idUsuario), no idParticipacion: un
/// usuario puede tener varios roles/participaciones en el proyecto, pero la
/// salida que solicita es de la persona respecto al proyecto como un todo, no
/// de una participación individual. A lo sumo puede existir una solicitud
/// abierta (PREPARACION o PENDIENTE_LIDER) simultánea por (idProyecto,
/// idUsuario), enforced por PostgreSQL (no por Prisma) vía el índice único
/// parcial `solicitud_salida_proyecto_pendiente_unique` (migración original
/// `20260811035302_add_solicitud_salida_proyecto`, ampliada en FND-05 —
/// migración `20260815160000_rename_exit_request_pending_and_extend_open_index`
/// — para cubrir ambos estados abiertos tras añadir PREPARACION en FND-04);
/// APROBADA/RECHAZADA/CANCELADA no están restringidas, así que el historial
/// completo se conserva y una persona puede volver a solicitar salir tras
/// resolverse la anterior. La aplicación deberá traducir una violación de esa
/// constraint (P2002) a 409 Conflict — no implementado en esta tarea.
model SolicitudSalidaProyecto {
  idSolicitud     Int                   @id @default(autoincrement()) @map("id_solicitud")
  idProyecto      Int                   @map("id_proyecto")
  idUsuario       Int                   @map("id_usuario")
  motivo          String                @db.Text
  estadoSolicitud EstadoSolicitudSalida @default(PENDIENTE_LIDER) @map("estado_solicitud")
  solicitadaEn    DateTime              @default(now()) @map("solicitada_en")
  resueltaEn      DateTime?             @map("resuelta_en")
  resueltaPor     Int?                  @map("resuelta_por")

  proyecto  Proyecto @relation(fields: [idProyecto], references: [idProyecto])
  usuario   Usuario  @relation("SolicitudSalidaSolicitante", fields: [idUsuario], references: [idUsuario])
  resolutor Usuario? @relation("SolicitudSalidaResolutor", fields: [resueltaPor], references: [idUsuario])

  @@index([idProyecto, idUsuario])
  @@map("solicitud_salida_proyecto")
}

model Hito {
  idHito          Int        @id @default(autoincrement()) @map("id_hito")
  idProyecto      Int        @map("id_proyecto")
  tituloHito      String     @map("titulo_hito") @db.VarChar(255)
  descripcionHito String?    @map("descripcion_hito") @db.Text
  fechaLimite     DateTime?  @map("fecha_limite") @db.Date
  estadoHito      EstadoHito @default(PENDIENTE) @map("estado_hito")
  orden           Int

  proyecto    Proyecto     @relation(fields: [idProyecto], references: [idProyecto])
  tareas      Tarea[]
  comentarios Comentario[]

  @@map("hito")
}

/// Invariante enforced por PostgreSQL (no por Prisma): a lo sumo un Sprint operable (estado ACTIVO o EN_FINALIZACION) por idProyecto, vía índice único parcial `sprint_operable_unique` (migración `20260815000000_add_sprint`). CERRADO no está restringido, así que el historial de sprints se conserva íntegro.
model Sprint {
  idSprint                  Int          @id @default(autoincrement()) @map("id_sprint")
  idProyecto                Int          @map("id_proyecto")
  numero                    Int
  estado                    EstadoSprint @default(ACTIVO)
  fechaInicio               DateTime     @default(now()) @map("fecha_inicio")
  fechaFinalizacionIniciada DateTime?    @map("fecha_finalizacion_iniciada")
  fechaCierre               DateTime?    @map("fecha_cierre")
  cerradoPor                Int?         @map("cerrado_por")

  proyecto           Proyecto             @relation(fields: [idProyecto], references: [idProyecto])
  cerrador           Usuario?             @relation(fields: [cerradoPor], references: [idUsuario])
  tareas             Tarea[]
  horasParticipacion HorasParticipacion[]

  @@index([idProyecto, estado])
  @@map("sprint")
}

model Tarea {
  idTarea             Int         @id @default(autoincrement()) @map("id_tarea")
  idProyecto          Int         @map("id_proyecto")
  idHito              Int?        @map("id_hito")
  idRolProyecto       Int?        @map("id_rol_proyecto")
  idSprint            Int         @map("id_sprint")
  tituloTarea         String      @map("titulo_tarea") @db.VarChar(255)
  descripcionTarea    String?     @map("descripcion_tarea") @db.Text
  estadoTarea         EstadoTarea @default(POR_HACER) @map("estado_tarea")
  prioridad           Prioridad   @default(MEDIA)
  orden               Int         @default(0) @map("orden")
  tiempoEstimadoHoras Int?        @map("tiempo_estimado_horas")
  creadaPor           Int         @map("creada_por")
  fechaCreacion       DateTime    @default(now()) @map("fecha_creacion")
  fechaLimite         DateTime?   @map("fecha_limite") @db.Date
  actualizadaEn       DateTime?   @map("actualizada_en")
  eliminadoEn         DateTime?   @map("eliminado_en")

  proyecto     Proyecto          @relation(fields: [idProyecto], references: [idProyecto])
  hito         Hito?             @relation(fields: [idHito], references: [idHito])
  rolProyecto  RolProyecto?      @relation(fields: [idRolProyecto], references: [idRolProyecto], onDelete: SetNull)
  sprint       Sprint            @relation(fields: [idSprint], references: [idSprint])
  creador      Usuario           @relation(fields: [creadaPor], references: [idUsuario])
  asignaciones AsignacionTarea[]
  evidencias   Evidencia[]
  comentarios  Comentario[]
  etiquetas    TareaEtiqueta[]

  @@index([idProyecto, eliminadoEn, estadoTarea])
  @@index([idProyecto, idRolProyecto])
  @@index([idHito])
  @@index([idSprint])
  @@map("tarea")
}

/// Invariante enforced por PostgreSQL (no por Prisma): a lo sumo una asignación activa (desasignadaEn IS NULL) por idTarea, vía índice único parcial `asignacion_tarea_activa_unique` (migración `20260720190329_enforce_one_active_task_assignment`).
/// Fuente de verdad de asignaciones de tareas: asignación vigente = `desasignadaEn == null`. El soft-delete de la tarea vive en `Tarea.eliminadoEn`, NO aquí.
/// idParticipacion (FND-06) es opcional y de mejor esfuerzo: solo los tramos
/// activos legacy fueron backfilleados (migración
/// `20260815170100_add_participacion_context_to_asignacion_tarea`), y solo
/// cuando existía una única ParticipacionProyecto ACTIVO inequívoca para el
/// mismo (usuario, rol de la tarea). Los tramos cerrados nunca se tocaron.
/// No usar como fuente de verdad histórica todavía: puede ser NULL incluso
/// en tramos donde una participación compatible sí existe.
model AsignacionTarea {
  idAsignacion    Int       @id @default(autoincrement()) @map("id_asignacion")
  idTarea         Int       @map("id_tarea")
  idUsuario       Int       @map("id_usuario")
  idParticipacion Int?      @map("id_participacion")
  fechaAsignacion DateTime  @default(now()) @map("fecha_asignacion")
  desasignadaEn   DateTime? @map("desasignada_en")
  asignadoPor     Int       @map("asignado_por")
  /// Horas realmente trabajadas por idUsuario durante ESTE tramo concreto de asignación (nunca el total de la tarea): una tarea reasignada tiene una fila de AsignacionTarea por tramo, y cada una lleva sus propias horas. Reportado manualmente por el líder al editar la tarea. Fuente granular que HU-126 (HorasParticipacion.horasCalculadas) consumirá después; no confundir con esa capa de agregación/aprobación, que este PR no implementa.
  horasReales     Decimal?  @map("horas_reales") @db.Decimal(6, 2)
  /// FND-09 (A5.1): marca el momento en que este tramo (horasReales) fue consumido por un proceso de reconocimiento de horas (Flow A: cálculo por Sprint / Flow B: reconocimiento anticipado por salida). NULL = todavía reconocible; NOT NULL = ya reconocido, no debe volver a sumarse. Sin default: todos los tramos existentes y los tramos nuevos nacen NULL — no hay trazabilidad histórica suficiente para inferir reconocimiento retroactivo, y ningún reconocimiento granular está implementado todavía (ver HorasParticipacion, que no referencia AsignacionTarea individuales).
  reconocidoEn    DateTime? @map("reconocido_en")

  tarea           Tarea                      @relation(fields: [idTarea], references: [idTarea])
  usuario         Usuario                    @relation("TareaAsignada", fields: [idUsuario], references: [idUsuario])
  asignador       Usuario                    @relation("TareaAsignador", fields: [asignadoPor], references: [idUsuario])
  participacion   ParticipacionProyecto?     @relation(fields: [idParticipacion], references: [idParticipacion], onDelete: SetNull)
  registrosAvance RegistroAvanceAsignacion[]

  @@index([idUsuario, desasignadaEn])
  @@index([idParticipacion])
  @@map("asignacion_tarea")
}

/// Registro de avance de una AsignacionTarea (FND-06 — Foundation de datos
/// exclusivamente). El contrato funcional futuro (B1: mínimo 200 caracteres,
/// autorización de autor, edición, ausencia de delete vía service) NO está
/// implementado aquí; esta tabla solo prepara la persistencia.
model RegistroAvanceAsignacion {
  idRegistroAvance Int       @id @default(autoincrement()) @map("id_registro_avance")
  idAsignacion     Int       @map("id_asignacion")
  idAutor          Int       @map("id_autor")
  contenido        String    @db.Text
  creadoEn         DateTime  @default(now()) @map("creado_en")
  editadoEn        DateTime? @map("editado_en")

  asignacion AsignacionTarea @relation(fields: [idAsignacion], references: [idAsignacion])
  autor      Usuario         @relation(fields: [idAutor], references: [idUsuario])

  @@map("registro_avance_asignacion")
}

model Etiqueta {
  idEtiqueta        Int    @id @default(autoincrement()) @map("id_etiqueta")
  idProyecto        Int    @map("id_proyecto")
  nombreEtiqueta    String @map("nombre_etiqueta") @db.VarChar(255)
  nombreNormalizado String @map("nombre_normalizado") @db.VarChar(255)
  color             String @db.VarChar(7)

  proyecto Proyecto        @relation(fields: [idProyecto], references: [idProyecto])
  tareas   TareaEtiqueta[]

  @@unique([idProyecto, nombreNormalizado])
  @@map("etiqueta")
}

model TareaEtiqueta {
  idTarea    Int @map("id_tarea")
  idEtiqueta Int @map("id_etiqueta")

  tarea    Tarea    @relation(fields: [idTarea], references: [idTarea])
  etiqueta Etiqueta @relation(fields: [idEtiqueta], references: [idEtiqueta], onDelete: Cascade)

  @@id([idTarea, idEtiqueta])
  @@index([idEtiqueta])
  @@map("tarea_etiqueta")
}

model Evidencia {
  idEvidencia       Int           @id @default(autoincrement()) @map("id_evidencia")
  idTarea           Int           @map("id_tarea")
  idUsuarioCargador Int           @map("id_usuario_cargador")
  tipoEvidencia     TipoEvidencia @map("tipo_evidencia")
  urlRecurso        String        @map("url_recurso") @db.VarChar(255)
  descripcion       String?       @db.Text
  tamanoBytes       BigInt?       @map("tamano_bytes")
  fechaEnvio        DateTime      @default(now()) @map("fecha_envio")

  tarea      Tarea               @relation(fields: [idTarea], references: [idTarea])
  cargador   Usuario             @relation(fields: [idUsuarioCargador], references: [idUsuario])
  revisiones RevisionEvidencia[]

  @@map("evidencia")
}

model RevisionEvidencia {
  idRevision        Int               @id @default(autoincrement()) @map("id_revision")
  idEvidencia       Int               @map("id_evidencia")
  idRevisor         Int               @map("id_revisor")
  resultadoRevision ResultadoRevision @map("resultado_revision")
  comentario        String?           @db.Text
  fechaRevision     DateTime          @default(now()) @map("fecha_revision")

  evidencia Evidencia @relation(fields: [idEvidencia], references: [idEvidencia])
  revisor   Usuario   @relation(fields: [idRevisor], references: [idUsuario])

  @@map("revision_evidencia")
}

/// Fuente de verdad de horas de una participación. Para horas reconocidas/agregadas se usa `horasAprobadas` únicamente cuando `estadoHoras = APROBADA`, siguiendo el patrón ya usado por el resto del código.
/// Invariante enforced por PostgreSQL (no por Prisma): a lo sumo una fila por (idParticipacion, idSprint) cuando idSprint NO es NULL, vía índice único parcial `horas_participacion_sprint_unique` (migración `20260816010000_add_sprint_hours_participation_uniqueness`, A7.1). Los registros históricos con idSprint = NULL no están restringidos: una participación conserva múltiples filas periódicas no vinculadas a Sprint.
/// horasCalculadas/idSprint (FND-07) son Foundation de datos exclusivamente:
/// preparan la persistencia para el futuro reconocimiento de horas por
/// Sprint (Flow A), pero no implementan todavía cálculo, reconocimiento,
/// ni la regla de que horasAprobadas != horasCalculadas exige
/// justificacionAjuste — esa validación es responsabilidad de la capa de
/// servicio, no del schema.
model HorasParticipacion {
  idRegistroHoras     Int         @id @default(autoincrement()) @map("id_registro_horas")
  idParticipacion     Int         @map("id_participacion")
  periodoInicio       DateTime    @map("periodo_inicio") @db.Date
  periodoFin          DateTime    @map("periodo_fin") @db.Date
  horasReportadas     Decimal     @map("horas_reportadas") @db.Decimal(6, 2)
  horasCalculadas     Decimal?    @map("horas_calculadas") @db.Decimal(6, 2)
  horasAprobadas      Decimal?    @map("horas_aprobadas") @db.Decimal(6, 2)
  justificacionAjuste String?     @map("justificacion_ajuste") @db.Text
  estadoHoras         EstadoHoras @default(PENDIENTE) @map("estado_horas")
  aprobadoPor         Int?        @map("aprobado_por")
  fechaAprobacion     DateTime?   @map("fecha_aprobacion")
  idSprint            Int?        @map("id_sprint")

  participacion ParticipacionProyecto @relation(fields: [idParticipacion], references: [idParticipacion])
  aprobador     Usuario?              @relation(fields: [aprobadoPor], references: [idUsuario])
  sprint        Sprint?               @relation(fields: [idSprint], references: [idSprint], onDelete: SetNull)

  @@index([idSprint])
  @@map("horas_participacion")
}

model Certificado {
