  idUsuario        Int                         @map("id_usuario")
  carneReferencia  String                      @map("carne_referencia") @db.VarChar(255)
  correoReferencia String                      @map("correo_referencia") @db.VarChar(255)
  estado           EstadoSolicitudRecuperacion @default(PENDIENTE)
  creadaEn         DateTime                    @default(now()) @map("creada_en")
  atendidaEn       DateTime?                   @map("atendida_en")
  atendidaPor      Int?                        @map("atendida_por")
  tokenUtilizadoEn DateTime?                   @map("token_utilizado_en")

  usuario Usuario  @relation("SolicitudRecuperacionUsuario", fields: [idUsuario], references: [idUsuario])
  admin   Usuario? @relation("SolicitudRecuperacionAdmin", fields: [atendidaPor], references: [idUsuario])

  @@index([estado])
  @@map("solicitud_recuperacion")
}

model RolAcceso {
