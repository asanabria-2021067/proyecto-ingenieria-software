# Plantilla de entorno (G01 · OWASP25-C019/C030). Solo nombres, tipo y
# defaults seguros: NUNCA valores reales ni de producción. Copiar a .env y
# completar las variables marcadas [obligatoria]; sin ellas docker compose o
# el backend se niegan a arrancar (fail-closed).
# En producción el .env lo genera el deploy con permisos 0600; la lista de
# nombres y sus consumidores vive en apps/backend/test/helpers/deploy-env-registry.ts.

# ── Entorno ───────────────────────────────────────────────
# texto: development | production | test (default: development)
NODE_ENV=development

# ── PostgreSQL (docker compose) ───────────────────────────
# texto (default: postgres)
DB_USER=postgres
# texto [obligatoria]: sin valor por defecto en compose
DB_PASSWORD=
# texto (default: uvg_collab)
DB_NAME=uvg_collab
# puerto publicado solo en 127.0.0.1 (default: 5432)
DB_PORT=5433
# URL postgres [obligatoria para ejecutar el backend fuera de Docker];
# reemplazar <DB_PASSWORD> por el valor de arriba
DATABASE_URL=postgresql://postgres:<DB_PASSWORD>@localhost:5433/uvg_collab?schema=public

# ── Autenticación ─────────────────────────────────────────
# texto [obligatoria], >=32 caracteres, aleatorio (p. ej. `openssl rand -base64 48`).
# Se rechazan valores por defecto conocidos.
JWT_SECRET=
# texto [obligatoria], aleatorio y distinto de JWT_SECRET
JWT_REFRESH_SECRET=
# URL http(s) absoluta del frontend [obligatoria]: origen CORS permitido
FRONTEND_URL=http://localhost:3000

# ── Frontend (público: se hornea en el bundle) ────────────
# URL http(s) del backend vista desde el navegador
NEXT_PUBLIC_API_URL=http://localhost:3001
# prefijo de la API (default: /api)
NEXT_PUBLIC_API_PREFIX=/api
# texto opcional: nube y preset públicos de Cloudinary para subidas desde el navegador
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=

# ── Flags de configuración ────────────────────────────────
# Patrón único: en deploy.yml cada flag es `${{ vars.NOMBRE || '<default>' }}`
# con un default que reproduce el comportamiento actual. G01 no registra
# flags propios; los gates posteriores documentan aquí los suyos.

# entero 0..10 (default: 0). Saltos de proxy confiables para calcular la IP del
# cliente (rate limiting). 0 = ignorar X-Forwarded-For (comportamiento actual).
# Poner 1 solo cuando el backend quede detrás de un único proxy (nginx) y sin
# puertos públicos propios; un valor inválido impide arrancar el backend.
TRUST_PROXY_HOPS=0

# 0.0.0.0 | 127.0.0.1 (default: 0.0.0.0). Interfaz del host donde docker compose
# publica backend (3001) y frontend (3000). 0.0.0.0 = exposición actual;
# 127.0.0.1 = accesibles solo desde el propio host (detrás de nginx).
BACKEND_BIND=0.0.0.0
FRONTEND_BIND=0.0.0.0

# true | false (default: false). Agrega el atributo Secure a las cookies de
# sesión (HttpOnly y SameSite=Lax siempre). Solo true cuando todo el tráfico
# llegue por HTTPS; un valor distinto de true/false impide arrancar el backend.
COOKIE_SECURE=false

# true | false (default: false). Alertas a administradores ante ráfagas de
# intentos fallidos o bloqueos de cuenta (notificación ALERTA_SEGURIDAD, una por
# hora como máximo). Con false no se evalúa ni se notifica nada.
SECURITY_ALERTS_ENABLED=false

# CSP_MODE (build-time, NO va en el .env): report-only | enforce (default:
# report-only). Se hornea en la imagen del frontend al construirla (build-arg
# del Dockerfile; en el deploy, `vars.CSP_MODE` y una variante inmutable propia).
